# Secreto compartido con Malvinas para firmar/verificar los links del
# checkout y autenticar el aviso de pago. Generá uno largo y al azar
# (ej: openssl rand -hex 32) y cargá EL MISMO en los dos proyectos.
CHECKOUT_SECRET=

# Access Token de PRODUCCIÓN de la aplicación de Mercado Pago
# (empieza con APP_USR-...). Se obtiene en
# https://www.mercadopago.com.ar/developers/panel/app
# → Tus integraciones → tu aplicación → Producción → Credenciales.
MP_ACCESS_TOKEN=

# URL del sistema Malvinas (para avisar el pago aprobado)
MALVINAS_URL=https://malvinasv4.vercel.app

# URL pública de ESTE checkout (para back_urls y webhook de MP).
# En Vercel se puede omitir: usa VERCEL_URL solo.
BASE_URL=
